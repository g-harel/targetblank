{
    "manifest_version": 3,
    "version": "1.1.5",
    "name": "targetblank",
    "description": "organize your links",
    "homepage_url": "https://targetblank.org",
    "incognito": "spanning",
    "applications": {
        "gecko": {
            "id": "extension@targetblank.org"
        }
    },

    "optional_permissions": ["storage"],
    "chrome_url_overrides": {
        "newtab": "index.html"
    }
}
